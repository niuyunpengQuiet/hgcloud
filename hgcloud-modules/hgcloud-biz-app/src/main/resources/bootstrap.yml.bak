spring:
  application:
    name: hgcloud-biz-app
  profiles:
    active: dev
  main:
    allow-circular-references: true
  cloud:
    nacos:
      config:
        server-addr: localhost:8848
        namespace: hgcloud-${spring.profiles.active}
        group: ${spring.profiles.active}
        prefix: ${spring.application.name}
        file-extension: yaml
        username: nacos
        password: nacos

